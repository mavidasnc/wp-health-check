{
    "name": "mavidasnc/wp-health-check",
    "description": "Must-use plugin di monitoraggio flotta WordPress con self-update firmato. Repository di tooling dev; il plugin distribuito e' un file PHP singolo autoconsistente (mu-plugins/wp-health-check.php).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpstan/phpstan": "^1.11",
        "php-stubs/wordpress-stubs": "^6.4",
        "phpstan/extension-installer": "^1.4",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2",
        "wp-phpunit/wp-phpunit": "7.1.1"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "npx @wordpress/env run tests-cli --env-cwd=wp-content/wphc-dev vendor/bin/phpunit",
        "test:check-locks": "php tests/tools/check-locks.php"
    }
}
