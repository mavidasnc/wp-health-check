# Dipendenze di sviluppo (PHPCS, PHPStan, stubs) - non servono a runtime
# composer.lock resta versionato per build riproducibili del tooling dev
/vendor/

# wp-env (Docker/wp-cli scaffolding locale)
.wp-env.override.json
# Override locale dell'ambiente e2e (porte, versione di PHP): non va committato
.wp-env.e2e.override.json

# Cache di PHPUnit e vendor dedicato alla matrice PHP 7.4 (vedi tests/README.md)
.phpunit.result.cache
/tests/php74/vendor/

# Node (se in futuro si aggiungono tool JS di sviluppo)
/node_modules/

# File di sistema
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
/.env
/prompt.txt
/.claude
/wp-health-check.prompt

# File .http con valori reali (token, host) per test locali: mai da committare.
/http/*.local.http

# Output di lavoro di graphify (cache estrazione, grafo grezzo, wiki temporaneo)
# docs/wiki/ e' la copia versionata destinata al repo.
/graphify-out/
# Ambiente e2e: copia di lavoro del plugin e file generati (vedi tests/e2e/README.md)
/tests/e2e/.work/
/tests/e2e/__pycache__/

# Cache di Python generata dagli script di test
__pycache__/
*.pyc

# Build di sviluppo (composer run build:dev): NON distribuibile, ha il marcatore WPHC-BUILD
/build/
