parameters:
    level: 5
    # Sorgente: src/ e bin/. mu-plugins/wp-health-check.php e' il file GENERATO da bin/build.php
    # (senza commenti con lo strip): non si analizza, si analizza il sorgente da cui nasce.
    paths:
        - src
        - bin
    scanFiles:
        # WP-CLI non fa parte del core WordPress: la classe WP_CLI, usata solo
        # dentro il branch defined('WP_CLI') && WP_CLI, va scansionata a parte.
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
